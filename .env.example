# Copy to .env.local and fill in values.

# Clerk — https://dashboard.clerk.com → Application → Configure → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# PostgreSQL — PRODUCTION (Vercel): use Neon DIRECT connection string (not localhost!)
# Neon dashboard → Connection details → "Direct connection" → copy URL
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional — features that call these will need keys
# ARCJET_KEY=
# GEMINI_API_KEY=
# RESEND_API_KEY=
