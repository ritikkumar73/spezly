{
  "name": "spenzly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "email": "email dev",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:up": "docker start spenzly-postgres 2>/dev/null || docker run -d --name spenzly-postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=password -e POSTGRES_DB=spenzly -p 5432:5432 -v spenzly_pgdata:/var/lib/postgresql/data postgres:16-alpine",
    "db:down": "docker stop spenzly-postgres",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@arcjet/next": "^1.0.0-beta.1",
    "@clerk/nextjs": "^6.9.0",
    "@google/generative-ai": "^0.21.0",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-email/components": "^0.0.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "inngest": "^3.54.2",
    "lucide-react": "^0.469.0",
    "next": "^16.2.3",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-spinners": "^0.15.0",
    "recharts": "^2.15.0",
    "resend": "^4.1.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "eslint": "^9",
    "eslint-config-next": "15.1.2",
    "postcss": "^8",
    "prisma": "^6.1.0",
    "react-email": "3.0.6",
    "tailwindcss": "^3.4.1"
  }
}
